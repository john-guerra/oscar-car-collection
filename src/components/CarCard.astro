---
import type { CollectionEntry } from 'astro:content';

interface Props {
  car: CollectionEntry<'cars'>;
}

const { car } = Astro.props;
const { data } = car;

// Determine icon based on type
const typeIcons: Record<string, string> = {
  'Touring': '🚗',
  'Racing': '🏎️',
  'Saloon': '🚙',
  'Sports': '🏎️',
  'Truck': '🚚',
  'Bus': '🚌',
  'Van': '🚐',
  'Fire Engine': '🚒',
  'Ambulance': '🚑',
  'Military': '🪖',
  'Taxi': '🚕',
  'Police': '🚔',
  'Motorcycle': '🏍️',
  'Locomotive': '🚂',
  'Other': '🚗',
  'Unknown': '🚗',
};

const icon = typeIcons[data.type] || '🚗';
const hasImage = data.images && data.images.length > 0;
---

<article class="car-card" data-car-id={car.slug}>
  <div class="car-icon">{icon}</div>

  {hasImage && (
    <div class="car-image-container">
      <img
        src={data.images[0]}
        alt={data.name}
        class="car-image"
        loading="lazy"
      />
    </div>
  )}

  <div class="car-info">
    <div class="car-year">{data.year}</div>
    <h3 class="car-name">{data.name}</h3>

    <div class="car-details">
      <span class="car-detail">
        <span class="detail-label">Type:</span> {data.type}
      </span>
      <span class="car-detail">
        <span class="detail-label">Origin:</span> {data.origin}
      </span>
      <span class="car-detail">
        <span class="detail-label">Maker:</span> {data.manufacturer}
      </span>
      <span class="car-detail">
        <span class="detail-label">Scale:</span> {data.scale}
      </span>
    </div>

    <div class="car-meta">
      <span class="car-material">{data.material}</span>
      <span class="car-made-in">Made in {data.madeIn}</span>
    </div>
  </div>

  <button class="view-details-btn" aria-label={`View details for ${data.name}`}>
    View Details
  </button>
</article>

<style>
  .car-card {
    background: var(--card-background);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .car-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .car-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .car-image-container {
    width: 100%;
    height: 180px;
    margin-bottom: 1rem;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .car-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .car-card:hover .car-image {
    transform: scale(1.05);
  }

  .car-info {
    text-align: center;
  }

  .car-year {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent-color);
    margin-bottom: 0.25rem;
  }

  .car-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .car-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .car-detail {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .detail-label {
    font-weight: 500;
    color: var(--text-muted);
  }

  .car-meta {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .view-details-btn {
    position: absolute;
    bottom: -40px;
    left: 0;
    right: 0;
    padding: 0.75rem;
    background: var(--accent-color);
    color: white;
    border: none;
    font-weight: 500;
    cursor: pointer;
    transition: bottom 0.2s ease;
  }

  .car-card:hover .view-details-btn {
    bottom: 0;
  }
</style>
